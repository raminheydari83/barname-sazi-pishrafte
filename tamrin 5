using System;

public class RecursiveMultiplier
{
    public static int Multiply(int a, int b)
    {
        if (b == 0)
        {
            return 0;
        }
        
        if (b == 1)
        {
            return a;
        }
        
      
        return a + Multiply(a, b - 1);
    }

    public static void Main(string[] args)
    {
        Console.WriteLine("--- Exercise 6: Recursive Multiplication ---");
        
        // Reading two integers from the user
        Console.Write("Enter the first number (A): ");
        int numA = Convert.ToInt32(Console.ReadLine());
        
        Console.Write("Enter the second number (B): ");
        int numB = Convert.ToInt32(Console.ReadLine());

        // Handling negative numbers (The basic recursive model assumes positive numbers. 
        // We use Math.Abs and reapply the sign.)
        int sign = 1;
        if ((numA < 0 && numB > 0) || (numA > 0 && numB < 0))
        {
            sign = -1;
        }
        
        int absoluteResult = Multiply(Math.Abs(numA), Math.Abs(numB));
        int finalResult = absoluteResult * sign;


        // Displaying results
        Console.WriteLine($"Result of {numA} x {numB} using recursion: {finalResult}");
        
        Console.ReadKey();
    }
}
